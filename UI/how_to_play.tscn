[node name="Rules" type="RichTextLabel" parent="margins/margin_lvl2/TabContainer/MarginContainer"]
layout_mode = 2
theme = ExtResource("1_wp8x0")
bbcode_enabled = true
text = "[b][center]CASINO — QUICK RULES[/center][/b]

[b]Setup[/b]
• Deal 4 cards to each player.  
• Place 4 cards face‑up on the table.  
• After all 4 cards are played, deal 4 more each until the deck is gone.

[b]Your Turn[/b]
Play 1 card and choose:

• [b]Capture[/b] — Take table cards that match your card’s rank or add up to it.  
• [b]Build[/b] — Combine a table card with your card to form a value you plan to capture later (you must hold that value).  
• [b]Trail[/b] — Place a card on the table only if you cannot capture or build.

[b]Scoring[/b]
• Most cards: 3 pts  
• Most spades: 1 pt  
• Each Ace: 1 pt  
• 2♠ Big Casino: 2 pts  
• 10♦ Little Casino"
text_direction = 1

